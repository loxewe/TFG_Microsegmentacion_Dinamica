#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=20

. /lib/functions.sh

DEFAULT_PROJECT_DIR="/root/tfg"
DEFAULT_PYTHON="/usr/bin/python3"
DEFAULT_CODEX="/usr/bin/codex"
DEFAULT_CODEX_HOME="/root/.codex"
DEFAULT_STATE_DIR="/var/lib/tfg-ai"
DEFAULT_INTEGRATIONS_DIR="/etc/tfg-ai/integrations"
DEFAULT_CREDENTIALS_DIR="/tmp/tfg-ai-credentials"
DEFAULT_DNS_SERVERS="1.1.1.1 8.8.8.8"
RUNNER="/usr/libexec/tfg-ai-discovery-runner"
LOG_FILE="/var/log/tfg/ai-discovery.log"

load_settings() {
    config_load tfg
    config_get PROJECT_DIR ai project_dir "$DEFAULT_PROJECT_DIR"
    config_get PYTHON ai python "$DEFAULT_PYTHON"
    config_get CODEX_BINARY ai codex_binary "$DEFAULT_CODEX"
    config_get CODEX_HOME ai codex_home "$DEFAULT_CODEX_HOME"
    config_get STATE_DIR ai state_dir "$DEFAULT_STATE_DIR"
    config_get INTEGRATIONS_DIR ai integrations_dir "$DEFAULT_INTEGRATIONS_DIR"
    config_get CREDENTIALS_DIR ai credentials_dir "$DEFAULT_CREDENTIALS_DIR"
    config_get DNS_SERVERS ai dns_servers "$DEFAULT_DNS_SERVERS"
    config_get JOB_ID ai job_id ""
}

boot() {
    logger -t tfg-ai-discovery "Servicio bajo demanda; no se inicia en el boot"
    return 0
}

start_service() {
    load_settings
    if [ -z "$JOB_ID" ]; then
        logger -t tfg-ai-discovery "No hay un job_id configurado"
        return 1
    fi
    if [ ! -x "$PYTHON" ]; then
        logger -t tfg-ai-discovery "Python no está disponible: $PYTHON"
        return 1
    fi
    if [ ! -x "$CODEX_BINARY" ]; then
        logger -t tfg-ai-discovery "Codex no está disponible: $CODEX_BINARY"
        return 1
    fi
    if [ ! -f "$CODEX_HOME/auth.json" ]; then
        logger -t tfg-ai-discovery \
            "No se encuentra la autenticación en $CODEX_HOME/auth.json"
        return 1
    fi
    if [ ! -f "$PROJECT_DIR/router_discovery.py" ]; then
        logger -t tfg-ai-discovery "No se encuentra router_discovery.py"
        return 1
    fi
    if [ ! -x "$RUNNER" ]; then
        logger -t tfg-ai-discovery "No se encuentra $RUNNER"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$RUNNER" "$PYTHON" \
        "$PROJECT_DIR/router_discovery.py" "$STATE_DIR" "$JOB_ID" \
        "$PROJECT_DIR" "$CODEX_BINARY" "$LOG_FILE" "$CREDENTIALS_DIR" \
        "$DNS_SERVERS" "$INTEGRATIONS_DIR"
    procd_set_param env HOME="/root" CODEX_HOME="$CODEX_HOME"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 10
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "tfg"
}
