#!/bin/sh

# Ejecuta un proceso supervisado por procd, conservando un PID y un log propios.
# Uso: tfg-service-runner PID_FILE LOG_FILE COMMAND [ARG ...]
if [ "$#" -lt 3 ]; then
    exit 64
fi

PID_FILE="$1"
LOG_FILE="$2"
shift 2

umask 077
mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")" || exit 1
printf '%s\n' "$$" > "$PID_FILE" || exit 1
cd "$(dirname "$LOG_FILE")" || exit 1
exec "$@" >> "$LOG_FILE" 2>&1
