config main 'main'
    option setup_complete '0'
    option wifi_radio 'radio0'
    option wifi_section 'wifinet1'

config service 'web'
    option project_dir '/root/tfg'
    option python '/usr/bin/python3'
    option listen '0.0.0.0'
    option port '80'

config service 'dhcp'
    option project_dir '/root/tfg'
    option python '/usr/bin/python3'
    option interface 'auto'

config service 'discovery'
    option project_dir '/root/tfg'
    option python '/usr/bin/python3'
    option interface 'auto'
    option reload_interval '2'
    option rate_limit '20'

config service 'zeek'
    option binary '/opt/zeek/bin/zeek'
    option interface 'auto'
    option log_dir '/var/log/tfg/zeek'

config service 'ai'
    option project_dir '/root/tfg'
    option python '/usr/bin/python3'
    option codex_binary '/usr/bin/codex'
    option codex_home '/root/.codex'
    option state_dir '/var/lib/tfg-ai'
    option integrations_dir '/etc/tfg-ai/integrations'
    option credentials_dir '/tmp/tfg-ai-credentials'
    option dns_servers '1.1.1.1 8.8.8.8'
    option discovery_mode 'assisted'
    option job_id ''
